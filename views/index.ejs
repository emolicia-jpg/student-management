<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Student Management</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <main class="container">
        <header class="page-header">
            <div>
                <p class="eyebrow">Student directory</p>
                <h1>Student Management System</h1>
            </div>
            <a class="button" href="/students/add">Add Student</a>
        </header>

        <section class="card" aria-labelledby="student-list-title">
            <div class="toolbar">
                <div>
                    <h2 id="student-list-title">Student List</h2>
                    <p class="section-description">Browse and search student records.</p>
                </div>
                <form class="search-form" action="/students/search" method="GET">
                    <div class="field">
                        <label for="keyword">Search students</label>
                        <input
                            id="keyword"
                            type="search"
                            name="keyword"
                            placeholder="Student ID, name, or course"
                        >
                    </div>
                    <button type="submit">Search</button>
                </form>
            </div>

            <% if (students.length > 0) { %>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Student ID</th>
                                <th scope="col">Name</th>
                                <th scope="col">Course</th>
                                <th scope="col">Year</th>
                                <th scope="col">Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach(student => { %>
                                <tr>
                                    <td><%= student.id %></td>
                                    <td><%= student.student_id %></td>
                                    <td><%= student.first_name %> <%= student.last_name %></td>
                                    <td><%= student.course %></td>
                                    <td><%= student.year_level %></td>
                                    <td><%= student.email %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="empty-state">No students found. Add a student or try another search.</p>
            <% } %>
        </section>
    </main>
</body>
</html>